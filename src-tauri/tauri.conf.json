{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Richard OS",
  "version": "0.1.0",
  "identifier": "com.sujith.richardos",
  "build": {
    "beforeDevCommand": "",
    "devUrl": "http://127.0.0.1:8000/ui/",
    "frontendDist": "../ui",
    "beforeBuildCommand": ""
  },
  "app": {
    "windows": [{
      "title": "Richard OS",
      "width": 1280,
      "height": 800,
      "resizable": true,
      "fullscreen": false
    }],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png"]
  }
}
